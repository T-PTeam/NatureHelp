# Copy to .env and fill in values. Do not commit .env.
# For local run (dotnet run): copy src/NatureHelp/appsettings.Local.json.example to src/NatureHelp/appsettings.Local.json instead.

# Production / Docker: database (docker-compose.prod.yml uses DATABASE_URL)
DATABASE_URL=

# OAuth (Docker compose maps these to backend; or set in appsettings.Local.json)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Optional: override appsettings when running backend (env vars override config)
# ConnectionStrings__LocalConnection=
# ConnectionStrings__DefaultConnection=
# ConnectionStrings__AzureBlobStorage=
# Redis__ConnectionString=
# Frontend__Url=
# Payment__PublicKey=
# Payment__PrivateKey=
# Payment__ResultUrl=
# EmailSettings__Username=
# EmailSettings__Password=
# EmailSettings__From=
# Cors__AllowedOrigins__0=
# Cors__AllowedOrigins__1=
