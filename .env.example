# Copy to .env and fill in values. Do not commit .env.
# For local run (dotnet run): copy src/NatureHelp/appsettings.Local.json.example to src/NatureHelp/appsettings.Local.json instead.

# Production / Docker: database (docker-compose.prod.yml uses DATABASE_URL)
DATABASE_URL=

# OAuth (Docker compose maps these to backend; or set in appsettings.Local.json)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# SuperAdmin (created on first backend startup if the email does not exist yet)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Optional: override appsettings when running backend (env vars override config)
# ConnectionStrings__LocalConnection=
# ConnectionStrings__DefaultConnection=
# Local Docker uses local file blob storage by default (see docker-compose.yml BlobStorage__UseLocalFiles).
# For dotnet run on host with Azurite: docker compose up -d azurite
# ConnectionStrings__AzureBlobStorage=UseDevelopmentStorage=true
# AzureBlobStorage__PublicBlobBaseUrl=http://127.0.0.1:10000/devstoreaccount1
# BlobStorage__UseLocalFiles=false
# Redis__ConnectionString=
# Frontend__Url=
# Payment__PublicKey=
# Payment__PrivateKey=
# Payment__ResultUrl=
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# EMAIL_FROM=
# Cors__AllowedOrigins__0=
# Cors__AllowedOrigins__1=
