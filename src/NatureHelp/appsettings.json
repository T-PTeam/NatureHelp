{
  "ConnectionStrings": {
    "LocalConnection": "",
    "DefaultConnection": "",
    "AzureBlobStorage": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:3000",
      "http://localhost:5051"
    ]
  },
  "Frontend": {
    "Url": ""
  },
  "Payment": {
    "PublicKey": "",
    "PrivateKey": "",
