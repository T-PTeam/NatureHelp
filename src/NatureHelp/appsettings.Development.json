{
  "ConnectionStrings": {
    "LocalConnection": "Host=localhost;Port=5432;Database=NatureHelpDB;Username=postgres;Password=",
    "DefaultConnection": "Host=localhost;Port=5432;Database=NatureHelpDB;Username=postgres;Password=",
    "AzureBlobStorage": "UseDevelopmentStorage=true"
  },
  "AzureBlobStorage": {
    "PublicBlobBaseUrl": "http://127.0.0.1:10000/devstoreaccount1"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:3000",
      "http://localhost:5051"
    ]
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "Username": "",
    "Password": "",
    "From": ""
  },
  "Frontend": {
    "Url": "http://localhost:4200/"
  },
  "Payment": {
    "PublicKey": "",
    "PrivateKey": "",
    "Url": "https://www.liqpay.ua/api/3/checkout",
    "ResultUrl": ""
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "/api/User/login",
        "Period": "5m",
        "Limit": 10
      },
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 60
      },
      {
        "Endpoint": "*",
        "Period": "1h",
        "Limit": 1000
      }
    ]
  },
  "Serilog": {
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Default": "Information",
        "Microsoft": "Warning",
        "Quartz": "Warning"
      }
    },
    "Using": [ 
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq",
      "Serilog.Sinks.Elasticsearch",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341",
          "apiKey": "j51PsN894Y5YVhWWNb9n",
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "http://localhost:9200",
          "indexFormat": "naturehelp-logs-{0:yyyy.MM.dd}",
          "restrictedToMinimumLevel": "Information",
          "autoRegisterTemplate": true,
          "templateName": "naturehelp-logs",
          "numberOfShards": 1,
          "numberOfReplicas": 0
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "restrictedToMinimumLevel": "Information",
          "labels": [
            {
              "key": "application",
              "value": "NatureHelp"
            },
            {
              "key": "environment",
              "value": "Development"
            }
          ]
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Warning"
    }
  },
  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false"
  },
  "OAuth2": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Facebook": {
      "AppId": "",
      "AppSecret": ""
    }
  }
}
